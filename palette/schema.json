{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sp_night palette",
  "type": "object",
  "required": [
    "name",
    "label",
    "description",
    "author",
    "url",
    "meaning",
    "groups",
    "flavors"
  ],
  "additionalProperties": false,
  "$defs": {
    "colorKey": {
      "description": "Um nome da paleta. Esta lista é a única no schema: meaning, groups, roles e as cores de cada flavor todas apontam para cá, então uma cor nova se escreve aqui e em flavors.*.colors.required, não em quatro lugares.",
      "enum": [
        "vao",
        "laje",
        "concreto",
        "vidro",
        "fiacao",
        "fg_vivo",
        "fg",
        "fg_dim",
        "fg_muted",
        "brasa",
        "sodio",
        "taxi",
        "ibira",
        "estaiada",
        "sereno",
        "marginal",
        "temporal",
        "brasa_vivo",
        "taxi_vivo",
        "ibira_vivo",
        "sereno_vivo",
        "marginal_vivo",
        "temporal_vivo"
      ]
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    }
  },
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "label": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "meaning": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/colorKey"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "groups": {
      "type": "object",
      "description": "As bandas semânticas da paleta, na ordem em que ela se lê. Elas particionam as cores: toda cor pertence a exatamente uma banda, e o motor recusa a paleta se sobrar ou faltar alguma. As bandas 'accents' e 'vivo' são as que a auditoria mede, e têm de existir.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "keys"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/colorKey"
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/colorKey"
        }
      },
      "description": "Camada semântica opcional aqui — no repositório ela vive em palette/roles.json, que o gerador carrega separado."
    },
    "flavors": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "label",
          "appearance",
          "description",
          "colors"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "appearance": {
            "enum": [
              "dark",
              "light"
            ]
          },
          "description": {
            "type": "string"
          },
          "colors": {
            "type": "object",
            "required": [
              "vao",
              "laje",
              "concreto",
              "vidro",
              "fiacao",
              "fg_vivo",
              "fg",
              "fg_dim",
              "fg_muted",
              "brasa",
              "sodio",
              "taxi",
              "ibira",
              "estaiada",
              "sereno",
              "marginal",
              "temporal",
              "brasa_vivo",
              "taxi_vivo",
              "ibira_vivo",
              "sereno_vivo",
              "marginal_vivo",
              "temporal_vivo"
            ],
            "propertyNames": {
              "$ref": "#/$defs/colorKey"
            },
            "additionalProperties": {
              "$ref": "#/$defs/hex"
            }
          }
        }
      }
    }
  }
}
